{
  "name": "ceru-plugin-tooling",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/sdk packages/issuer packages/core packages/cli packages/create && node scripts/build-runtime.mjs",
    "docs:operations": "node scripts/generate-operations.mjs",
    "check:host-components": "tsc --noEmit --skipLibCheck --strict --target ES2022 --module NodeNext packages/core/runtime/host-components.ts",
    "test": "npm run build && npm run check:host-components && node scripts/generate-operations.mjs --check && node --test --test-concurrency=1 test/*.test.mjs",
    "test:sdk-package": "node --test test/sdk-package.test.mjs",
    "pack:all": "node scripts/pack.mjs",
    "pack:devkit": "node scripts/build-devkit.mjs",
    "verify:devkit": "node scripts/verify-devkit.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "verify:dual-runtime": "node scripts/verify-dual-runtime.mjs"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/core": "file:vendor/amll/applemusic-like-lyrics-core-0.6.0+git.5fee356.tgz",
    "@pixi/app": "7.4.3",
    "@pixi/core": "7.4.3",
    "@pixi/display": "7.4.3",
    "@pixi/filter-blur": "7.4.3",
    "@pixi/filter-bulge-pinch": "5.1.1",
    "@pixi/filter-color-matrix": "7.4.3",
    "@pixi/sprite": "7.4.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "web-streams-polyfill": "4.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
