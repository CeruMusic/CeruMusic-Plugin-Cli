{
  "name": "ceru-plugin-tooling",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/sdk packages/issuer packages/core packages/cli packages/create && node scripts/build-runtime.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:sdk-package": "node --test test/sdk-package.test.mjs",
    "pack:all": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
