{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ceru Plugin Build Configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor schema reference; ignored by the build runtime."
    },
    "manifest": {
      "type": "object",
      "properties": {
        "manifestVersion": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "homepage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "engines": {
          "type": "object",
          "properties": {
            "hostApi": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "logicRuntime": {
              "const": "ceru-js@1"
            },
            "uiSchema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "libraries": {
              "type": "object",
              "properties": {
                "vue": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "react": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "react-dom": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "hostApi",
            "logicRuntime"
          ],
          "additionalProperties": false
        },
        "modules": {
          "type": "object",
          "properties": {
            "logic": {
              "type": "object",
              "properties": {
                "entry": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "activation": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "maxItems": 128,
                  "uniqueItems": true
                }
              },
              "required": [
                "entry"
              ],
              "additionalProperties": false
            },
            "surfaces": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "kind": {
                    "enum": [
                      "schema",
                      "web"
                    ]
                  },
                  "entry": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "entry"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "contributes": {
          "type": "object",
          "properties": {
            "menus": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "commandId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "slot": {
                    "enum": [
                      "playlist.import",
                      "playlist.actions",
                      "track.actions",
                      "player.actions",
                      "search.tools"
                    ]
                  },
                  "icon": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "host"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          }
                        },
                        "required": [
                          "kind",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "asset"
                          },
                          "resource": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                          }
                        },
                        "required": [
                          "kind",
                          "resource"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "when": {
                    "type": "object",
                    "properties": {
                      "kinds": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "track",
                            "playlist"
                          ]
                        }
                      },
                      "loggedIn": {
                        "type": "boolean"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "slot",
                  "title",
                  "commandId"
                ],
                "additionalProperties": false
              }
            },
            "homeSections": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "kind": {
                    "enum": [
                      "playlists",
                      "charts",
                      "custom"
                    ]
                  },
                  "icon": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "host"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          }
                        },
                        "required": [
                          "kind",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "asset"
                          },
                          "resource": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                          }
                        },
                        "required": [
                          "kind",
                          "resource"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "view": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "providerIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "id",
                  "title",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "uiExtensions": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "slot": {
                    "enum": [
                      "home.header",
                      "home.content.before",
                      "home.content.after",
                      "search.source-selector.after",
                      "playlist.header.actions",
                      "playlist.item.actions",
                      "player.actions",
                      "settings.sections"
                    ]
                  },
                  "mode": {
                    "enum": [
                      "append",
                      "prepend",
                      "wrap",
                      "replace"
                    ]
                  },
                  "view": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "when": {
                    "type": "object",
                    "properties": {
                      "loggedIn": {
                        "type": "boolean"
                      },
                      "route": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "slot",
                  "mode",
                  "view"
                ],
                "additionalProperties": false
              }
            },
            "styles": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "resource": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "scope": {
                    "enum": [
                      "surface",
                      "slot",
                      "application"
                    ]
                  },
                  "slots": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "enum": [
                        "home.header",
                        "home.content.before",
                        "home.content.after",
                        "search.source-selector.after",
                        "playlist.header.actions",
                        "playlist.item.actions",
                        "player.actions",
                        "settings.sections"
                      ]
                    }
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "id",
                  "resource",
                  "scope"
                ],
                "additionalProperties": false
              }
            },
            "playlistImporters": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false
              }
            },
            "providers": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "protocols": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "qualities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  },
                  "connectionMode": {
                    "enum": [
                      "none",
                      "single",
                      "multiple"
                    ]
                  },
                  "icon": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "host"
                          },
                          "name": {
                            "type": "string",
                            "examples": [
                              "platform.tx",
                              "platform.kg",
                              "platform.kw",
                              "platform.wy",
                              "platform.mg",
                              "platform.local",
                              "platform.all",
                              "search",
                              "music-note",
                              "library",
                              "cloud",
                              "server",
                              "import",
                              "chart",
                              "settings",
                              "play",
                              "pause",
                              "download",
                              "share",
                              "account",
                              "heart",
                              "refresh",
                              "close",
                              "add",
                              "info"
                            ],
                            "description": "Host built-in icon name; no icon file is embedded into the plugin."
                          }
                        },
                        "required": [
                          "kind",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "asset"
                          },
                          "resource": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                          }
                        },
                        "required": [
                          "kind",
                          "resource"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "protocols"
                ],
                "additionalProperties": false
              }
            },
            "commands": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "action": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "view": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "action"
                ],
                "additionalProperties": false
              }
            },
            "sidebarItems": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "group": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "view": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "id",
                  "group",
                  "title",
                  "view"
                ],
                "additionalProperties": false
              }
            },
            "settingsPages": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "view": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "view"
                ],
                "additionalProperties": false
              }
            },
            "guestAdapters": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "format": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "compatibilityProfile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "bootstrap": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "runtime": {
                    "const": "ceru-js@1"
                  },
                  "projectableProtocols": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "maxItems": 128,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "format",
                  "compatibilityProfile",
                  "bootstrap",
                  "runtime",
                  "projectableProtocols"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "permissions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "name": {
                "enum": [
                  "account.profile",
                  "downloads.manage",
                  "localMusic.read",
                  "localMusic.write",
                  "settings.read",
                  "settings.write",
                  "window.control",
                  "hotkeys.register",
                  "rooms.read",
                  "rooms.control",
                  "ai.use",
                  "devices.control",
                  "ui.styles.global",
                  "network.request",
                  "network.socket",
                  "network.private",
                  "network.discovery",
                  "credentials.use",
                  "credentials.read",
                  "library.read",
                  "library.write",
                  "library.delete",
                  "player.read",
                  "player.control",
                  "playback.fallback.hold",
                  "files.read",
                  "files.write",
                  "downloads.create",
                  "clipboard.read",
                  "clipboard.write",
                  "notifications.system",
                  "external.open",
                  "background.run",
                  "services.consume",
                  "sharing.publish",
                  "sharing.revoke",
                  "guests.manage",
                  "guests.run"
                ]
              },
              "scope": {
                "type": "object"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "optional": {
                "type": "boolean"
              },
              "requiredFor": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "maxItems": 128,
                "uniqueItems": true
              }
            },
            "required": [
              "key",
              "name",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "guestPolicy": {
          "type": "object",
          "properties": {
            "maxDepth": {
              "const": 1
            },
            "allowedCapabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 128,
              "uniqueItems": true
            },
            "networkScopeMode": {
              "const": "per-guest-user-approved"
            },
            "allowNativeCode": {
              "const": false
            },
            "allowRemoteCodeExecution": {
              "const": false
            }
          },
          "required": [
            "maxDepth",
            "allowedCapabilities",
            "networkScopeMode",
            "allowNativeCode",
            "allowRemoteCodeExecution"
          ],
          "additionalProperties": false
        },
        "dataSchemas": {
          "type": "object",
          "properties": {
            "config": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "config",
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "manifestVersion",
        "id",
        "name",
        "version",
        "engines",
        "modules"
      ],
      "additionalProperties": false
    },
    "config": {
      "oneOf": [
        {
          "type": "object",
          "description": "JSON-compatible defaults exposed through ctx.config.",
          "additionalProperties": true
        },
        {
          "type": "string",
          "pattern": "^@.+",
          "description": "Build-time JSON/JS/TS config reference, for example @./src/plugin.config.ts."
        }
      ]
    },
    "entries": {
      "type": "object",
      "description": "Map stable module IDs to TS/TSX/JS source files",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "json",
              "text",
              "base64"
            ]
          },
          "mime": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "string",
      "default": "dist/plugin.js",
      "pattern": "\\.(?:js|jsx)$"
    },
    "framework": {
      "enum": [
        "vanilla",
        "vue",
        "react"
      ],
      "default": "vanilla"
    },
    "sharedLibraries": {
      "deprecated": true,
      "description": "Legacy field ignored since 0.1.2. Vue and React production runtimes are bundled into the plugin.",
      "type": "object",
      "properties": {
        "vue": {
          "type": "string"
        },
        "react": {
          "type": "string"
        },
        "react-dom": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "webDist": {
      "type": "object",
      "description": "Map a Surface entry ID to an already-built local HTML directory",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "manifest",
    "entries"
  ],
  "additionalProperties": false
}
