{
  "name": "@shiqianjiang/ceru-plugin-core",
  "version": "3.0.1",
  "description": "Ceru Music v3 plugin Core runtime and Host adapter boundary",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./component-runtime": {
      "types": "./dist/component-runtime.d.ts",
      "default": "./dist/component-runtime.js"
    },
    "./trusted": {
      "types": "./dist/trusted-runtime/index.d.ts",
      "default": "./dist/trusted-runtime/index.js"
    },
    "./server": {
      "types": "./dist/http-server.d.ts",
      "default": "./dist/http-server.js"
    },
    "./media": {
      "types": "./dist/media-stream.d.ts",
      "default": "./dist/media-stream.js"
    },
    "./operations": {
      "types": "./dist/operation-bus.d.ts",
      "default": "./dist/operation-bus.js"
    },
    "./services": {
      "types": "./dist/service-router.d.ts",
      "default": "./dist/service-router.js"
    },
    "./sockets": {
      "types": "./dist/socket-broker.d.ts",
      "default": "./dist/socket-broker.js"
    },
    "./music": {
      "types": "./dist/music-registry.d.ts",
      "default": "./dist/music-registry.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./guests": {
      "types": "./dist/guest-store.d.ts",
      "default": "./dist/guest-store.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "default": "./dist/surface.js"
    },
    "./surface-document": {
      "types": "./dist/surface-document.d.ts",
      "default": "./dist/surface-document.js"
    },
    "./host-library": {
      "types": "./dist/host-library.d.ts",
      "default": "./dist/host-library.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.ts",
      "default": "./dist/dispatch.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT AND AGPL-3.0-only",
  "author": "澜音团队",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@shiqianjiang/ceru-plugin-issuer": "3.0.1",
    "@shiqianjiang/ceru-plugin-sdk": "3.0.1",
    "axios": "^1.13.2",
    "semver": "^7.7.0",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CeruMusic/CeruMusic-Plugin-Cli.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ceru-music",
    "plugin",
    "core",
    "electron"
  ]
}
